<UserControl x:Class="K162.App.Views.SetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:K162.App.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <controls:CutCornerBorder MaxWidth="560" Margin="24,48" CutSize="14" Padding="28,24"
                                  HorizontalAlignment="Center" VerticalAlignment="Top"
                                  Fill="{StaticResource Accent03Brush}" Stroke="{StaticResource Accent30Brush}">
            <StackPanel>
                <TextBlock FontFamily="{StaticResource MonoFont}" FontSize="20"
                           Foreground="{StaticResource AccentBrush}"
                           Text="K162 FLEET INTEL"/>
                <TextBlock Margin="0,6,0,0" FontSize="14" Foreground="{StaticResource TextBodyBrush}"
                           TextWrapping="Wrap"
                           Text="Track every online character across your accounts, see wormhole intel the moment you jump, and get alerted when something dies in a system you just left."/>

                <TextBlock Margin="0,22,0,0" Style="{StaticResource MonoLabel}"
                           Text="1 · REGISTER AN ESI APPLICATION"/>
                <TextBlock Margin="0,6,0,0" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap">
                    <Run Text="Create an application at "/><Hyperlink Foreground="{StaticResource AccentBrush}" Click="DevPortal_Click">developers.eveonline.com</Hyperlink><Run Text=" with scopes "/><Run FontFamily="{StaticResource MonoFont}" FontSize="11" Text="esi-location.read_location.v1 esi-location.read_online.v1 esi-location.read_ship_type.v1"/><Run Text=" and callback URL "/><Run FontFamily="{StaticResource MonoFont}" FontSize="11" Text="http://localhost:8410/callback/"/><Run Text=". Paste its client id below."/>
                </TextBlock>
                <TextBox Margin="0,10,0,0" Style="{StaticResource DarkTextBox}"
                         Text="{Binding Settings.EsiClientId, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Margin="0,20,0,0" Style="{StaticResource MonoLabel}"
                           Text="2 · AUTHORIZE YOUR CHARACTERS"/>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Style="{StaticResource AccentCutButton}" Content="ADD CHARACTER"
                            Command="{Binding AddCharacterCommand}"/>
                    <Button Style="{StaticResource OutlineButton}" Content="START DEMO" Margin="10,0,0,0"
                            Padding="14,7" Command="{Binding StartDemoCommand}"/>
                </StackPanel>
                <TextBlock Margin="0,10,0,0" FontFamily="{StaticResource MonoFont}" FontSize="11"
                           Foreground="{StaticResource WarmBrush}" TextWrapping="Wrap"
                           Text="{Binding SetupStatus}"/>
                <TextBlock Margin="0,18,0,0" FontSize="12" Foreground="{StaticResource TextFaintBrush}" TextWrapping="Wrap"
                           Text="Demo mode shows the full interface with simulated pilots — no login needed. Refresh tokens are stored DPAPI-encrypted for your Windows user only."/>
            </StackPanel>
        </controls:CutCornerBorder>
    </ScrollViewer>
</UserControl>
