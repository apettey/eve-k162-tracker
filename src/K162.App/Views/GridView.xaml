<UserControl x:Class="K162.App.Views.GridView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:K162.App.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <ItemsControl ItemsSource="{Binding Pilots}" MaxWidth="1500" Margin="24,18"
                      HorizontalAlignment="Stretch">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <controls:AutoFitPanel MinItemWidth="430" Gap="14"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid Visibility="{Binding Online, Converter={StaticResource BoolToVis}}">
                        <Button Style="{StaticResource InvisibleButton}"
                                Command="{Binding DataContext.FocusPilotCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}">
                        <controls:CutCornerBorder x:Name="Card" CutSize="12" Cursor="Hand">
                            <controls:CutCornerBorder.Style>
                                <Style TargetType="controls:CutCornerBorder">
                                    <Setter Property="Fill" Value="{StaticResource CardBrush}"/>
                                    <Setter Property="Stroke" Value="{StaticResource Accent22Brush}"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Stroke" Value="{StaticResource Accent60Brush}"/>
                                            <Setter Property="Fill" Value="{StaticResource Accent04Brush}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </controls:CutCornerBorder.Style>
                            <StackPanel>
                                <!-- Header: portrait / name / ship / threat -->
                                <Border BorderThickness="0,0,0,1" BorderBrush="{StaticResource Accent12Brush}"
                                        Padding="14,12">
                                    <DockPanel>
                                        <Border DockPanel.Dock="Left" Width="44" Height="44"
                                                BorderThickness="1" BorderBrush="{StaticResource Accent30Brush}"
                                                Background="{StaticResource Accent04Brush}">
                                            <Image Source="{Binding PortraitUrl}" Stretch="UniformToFill"/>
                                        </Border>
                                        <Border DockPanel.Dock="Right" VerticalAlignment="Center"
                                                BorderThickness="1" Padding="10,3"
                                                BorderBrush="{Binding Threat, Converter={StaticResource ThreatBrush}}">
                                            <TextBlock x:Name="ThreatText" FontFamily="{StaticResource MonoFont}" FontSize="11"
                                                       Foreground="{Binding Threat, Converter={StaticResource ThreatBrush}}"
                                                       Text="{Binding ThreatLabel}"/>
                                        </Border>
                                        <StackPanel Margin="12,0" VerticalAlignment="Center">
                                            <TextBlock FontSize="17" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextBrightBrush}"
                                                       Text="{Binding Name}"/>
                                            <TextBlock FontFamily="{StaticResource MonoFont}" FontSize="11"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       Text="{Binding ShipName}"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                                <!-- System line -->
                                <StackPanel Orientation="Horizontal" Margin="14,10,14,2">
                                    <TextBlock FontFamily="{StaticResource MonoFont}" FontSize="24"
                                               Foreground="{StaticResource AccentBrush}"
                                               Text="{Binding SystemName}" VerticalAlignment="Bottom"/>
                                    <TextBlock Margin="10,0,0,3" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               Text="{Binding SystemClass}" VerticalAlignment="Bottom"/>
                                    <TextBlock Margin="10,0,0,3" FontSize="12"
                                               Foreground="{StaticResource WarmBrush}"
                                               Text="{Binding Effect}" VerticalAlignment="Bottom"/>
                                </StackPanel>
                                <!-- Statics -->
                                <ItemsControl ItemsSource="{Binding Statics}" Margin="14,4,14,10">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderThickness="1" BorderBrush="{StaticResource Accent22Brush}"
                                                    Padding="7,2" Margin="0,0,6,4">
                                                <TextBlock FontFamily="{StaticResource MonoFont}" FontSize="10"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           Text="{Binding CardText}"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <!-- 48h sparkline -->
                                <Border BorderThickness="0,1,0,0" BorderBrush="{StaticResource Accent08Brush}"
                                        Padding="14,8,14,0">
                                    <controls:Sparkline Height="34" Bins="{Binding Bins}" Gap="2"
                                                        ActiveBrush="{StaticResource Accent75Brush}"
                                                        ZeroBrush="{StaticResource Accent12Brush}"/>
                                </Border>
                                <!-- Footer -->
                                <DockPanel Margin="14,8,14,12">
                                    <TextBlock DockPanel.Dock="Left" FontFamily="{StaticResource MonoFont}" FontSize="11"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               Text="{Binding KillSummary}"/>
                                    <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right"
                                               FontFamily="{StaticResource MonoFont}" FontSize="11"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               Text="{Binding ResidentSummary}"/>
                                </DockPanel>
                            </StackPanel>
                        </controls:CutCornerBorder>
                        </Button>
                        <!-- Jump flash overlay -->
                        <controls:CutCornerBorder x:Name="FlashOverlay" CutSize="12" IsHitTestVisible="False"
                                                  Stroke="{StaticResource Accent90Brush}" Opacity="0">
                            <controls:CutCornerBorder.Effect>
                                <DropShadowEffect Color="#3ECF7A" BlurRadius="40" ShadowDepth="0" Opacity="0.55"/>
                            </controls:CutCornerBorder.Effect>
                        </controls:CutCornerBorder>
                    </Grid>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsFlashing}" Value="True">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard x:Name="JumpFlash">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="FlashOverlay"
                                                         Storyboard.TargetProperty="Opacity"
                                                         From="1" To="0" Duration="0:0:1.5">
                                            <DoubleAnimation.EasingFunction>
                                                <ExponentialEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="JumpFlash"/>
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Threat}" Value="Hot">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard x:Name="HotBadgePulse">
                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                        <DoubleAnimation Storyboard.TargetName="ThreatText"
                                                         Storyboard.TargetProperty="Opacity"
                                                         From="1" To="0.45" Duration="0:0:0.6"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="HotBadgePulse"/>
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </ScrollViewer>
</UserControl>
