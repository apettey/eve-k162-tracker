<Window x:Class="K162.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:K162.App.Controls"
        xmlns:views="clr-namespace:K162.App.Views"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="{Binding WindowTitle}"
        Width="1560" Height="940" MinWidth="980" MinHeight="620"
        Background="{StaticResource AppBrush}"
        Foreground="{StaticResource TextBodyBrush}"
        FontFamily="{StaticResource UiFont}"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="34" ResizeBorderThickness="6"
                            GlassFrameThickness="0" CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="34"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="26"/>
        </Grid.RowDefinitions>

        <!-- Faint radial green glow behind the app area -->
        <Rectangle Grid.Row="1" Grid.RowSpan="3" IsHitTestVisible="False">
            <Rectangle.Fill>
                <RadialGradientBrush GradientOrigin="0.5,-0.1" Center="0.5,-0.1" RadiusX="0.8" RadiusY="0.6">
                    <GradientStop Color="#0F3ECF7A" Offset="0"/>
                    <GradientStop Color="#003ECF7A" Offset="1"/>
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- ============ Custom title bar ============ -->
        <Grid Grid.Row="0" Background="{StaticResource ChromeBrush}">
            <Border BorderBrush="{StaticResource ChromeBorderBrush}" BorderThickness="0,0,0,1"/>
            <StackPanel Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                <controls:CutCornerBorder Width="14" Height="14" CutSize="4"
                                          Stroke="{StaticResource AccentBrush}" Fill="Transparent"/>
                <TextBlock Margin="8,0,0,0" VerticalAlignment="Center"
                           FontFamily="{StaticResource MonoFont}" FontSize="11"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Text="{Binding WindowTitle}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource ChromeButton}" Content="─" Click="Minimize_Click"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                <Button Style="{StaticResource ChromeButton}" Content="▢" FontSize="12" Click="MaximizeRestore_Click"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                <Button Style="{StaticResource ChromeCloseButton}" Content="✕" Click="Close_Click"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
            </StackPanel>
        </Grid>

        <!-- ============ Top app bar ============ -->
        <Border Grid.Row="1" Padding="24,14" BorderThickness="0,0,0,1"
                BorderBrush="{StaticResource Accent18Brush}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <TextBlock Text="K162" FontFamily="{StaticResource MonoFont}" FontSize="20"
                               Foreground="{StaticResource AccentBrush}" VerticalAlignment="Bottom"/>
                    <TextBlock Margin="10,0,0,2" VerticalAlignment="Bottom" FontSize="13"
                               Foreground="{StaticResource TextMutedBrush}"
                               Text="{Binding Source='FLEET INTEL', Converter={StaticResource Tracking}, ConverterParameter=3}"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <TextBlock VerticalAlignment="Center" Margin="0,0,16,0"
                               FontFamily="{StaticResource MonoFont}" FontSize="12"
                               Foreground="{StaticResource TextMutedBrush}"
                               Text="{Binding OnlineCountLabel}"/>
                    <Button Style="{StaticResource AccentCutButton}"
                            Content="{Binding PrimaryActionLabel}"
                            Command="{Binding PrimaryActionCommand}"/>
                </StackPanel>
                <Border/>
            </DockPanel>
        </Border>

        <!-- ============ Wake Watch strip ============ -->
        <Border Grid.Row="2" Padding="24,8" Background="{StaticResource Accent02Brush}"
                BorderThickness="0,0,0,1" BorderBrush="{StaticResource Accent12Brush}"
                Visibility="{Binding HasHeld, Converter={StaticResource BoolToVis}}">
            <WrapPanel>
                <TextBlock VerticalAlignment="Center" Margin="0,0,10,0" Style="{StaticResource MonoLabel}"
                           Text="WAKE WATCH"/>
                <TextBlock VerticalAlignment="Center" Margin="0,0,10,0"
                           FontFamily="{StaticResource MonoFont}" FontSize="10"
                           Foreground="{StaticResource TextFaintBrush}"
                           Text="{Binding HoldHelperText}"/>
                <ItemsControl ItemsSource="{Binding HeldChips}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="Chip" BorderThickness="1" Padding="8,2" Margin="0,0,8,2"
                                    BorderBrush="{StaticResource Accent25Brush}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="Sys" FontFamily="{StaticResource MonoFont}" FontSize="10"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               Text="{Binding SystemName}"/>
                                    <TextBlock FontFamily="{StaticResource MonoFont}" FontSize="10"
                                               Foreground="{StaticResource TextMutedBrush}">
                                        <Run Text=" · "/><Run Text="{Binding PilotFirstName, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Remaining, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Alerted}" Value="True">
                                    <Setter TargetName="Chip" Property="BorderBrush" Value="{StaticResource HotBrush}"/>
                                    <Setter TargetName="Sys" Property="Foreground" Value="{StaticResource HotBrush}"/>
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard x:Name="ChipPulse">
                                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                <DoubleAnimation Storyboard.TargetName="Chip"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 From="1" To="0.45" Duration="0:0:0.6"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                    <DataTrigger.ExitActions>
                                        <StopStoryboard BeginStoryboardName="ChipPulse"/>
                                    </DataTrigger.ExitActions>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </WrapPanel>
        </Border>

        <!-- ============ Content: setup / grid / focus ============ -->
        <Grid Grid.Row="3">
            <views:SetupView Visibility="{Binding IsSetup, Converter={StaticResource BoolToVis}}"/>
            <views:GridView Visibility="{Binding IsGrid, Converter={StaticResource BoolToVis}}"/>
            <views:FocusView Visibility="{Binding IsFocus, Converter={StaticResource BoolToVis}}"/>
        </Grid>

        <!-- ============ Status bar ============ -->
        <Border Grid.Row="4" Background="{StaticResource ChromeBrush}" BorderThickness="0,1,0,0"
                BorderBrush="{StaticResource ChromeBorderBrush}" Padding="14,0">
            <DockPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <TextBlock FontFamily="{StaticResource MonoFont}" FontSize="10"
                               Foreground="{StaticResource TextFaintBrush}" Text="{Binding VersionText}"/>
                    <TextBlock Margin="18,0,0,0" FontFamily="{StaticResource MonoFont}" FontSize="10"
                               Foreground="{StaticResource TextFaintBrush}">
                        <Run Text="ESI: "/><Run Text="{Binding EsiStatusText, Mode=OneWay}" Foreground="{StaticResource AccentBrush}"/>
                    </TextBlock>
                    <TextBlock Margin="18,0,0,0" FontFamily="{StaticResource MonoFont}" FontSize="10"
                               Foreground="{StaticResource TextFaintBrush}">
                        <Run Text="zKillboard RedisQ: "/><Run Text="{Binding RedisqStatusText, Mode=OneWay}" Foreground="{StaticResource AccentBrush}"/>
                    </TextBlock>
                    <Button Margin="18,0,0,0" Style="{StaticResource LinkButton}" FontSize="10"
                            Foreground="{StaticResource WarmBrush}"
                            Content="{Binding UpdateChipText}"
                            Command="{Binding ApplyUpdateCommand}"
                            Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
                <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right"
                           FontFamily="{StaticResource MonoFont}" FontSize="10"
                           Foreground="{StaticResource TextFaintBrush}" Text="{Binding TqTime}"/>
            </DockPanel>
        </Border>

        <!-- ============ Kill-in-wake toast ============ -->
        <controls:CutCornerBorder Grid.Row="1" Grid.RowSpan="3" Width="320" CutSize="10"
                                  HorizontalAlignment="Right" VerticalAlignment="Top"
                                  Margin="0,44,44,0" Panel.ZIndex="50"
                                  Fill="{StaticResource HotBgBrush}" Stroke="{StaticResource HotBrush}"
                                  Visibility="{Binding HasToast, Converter={StaticResource BoolToVis}}">
            <controls:CutCornerBorder.Effect>
                <DropShadowEffect Color="#E0563C" BlurRadius="30" ShadowDepth="0" Opacity="0.35"/>
            </controls:CutCornerBorder.Effect>
            <controls:CutCornerBorder.Triggers>
                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.25"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </controls:CutCornerBorder.Triggers>
            <StackPanel>
                <DockPanel Margin="12,8">
                    <TextBlock DockPanel.Dock="Left" FontFamily="{StaticResource MonoFont}" FontSize="11"
                               Foreground="{StaticResource HotBrush}"
                               Text="⚠ KILL IN WAKE">
                        <TextBlock.Triggers>
                            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                <BeginStoryboard Storyboard="{StaticResource HotPulseStoryboard}"/>
                            </EventTrigger>
                        </TextBlock.Triggers>
                    </TextBlock>
                    <Button DockPanel.Dock="Right" HorizontalAlignment="Right"
                            Style="{StaticResource LinkButton}" FontSize="12"
                            Foreground="{StaticResource TextMutedBrush}" Content="✕"
                            Command="{Binding DismissToastCommand}"/>
                </DockPanel>
                <Border Height="1" Background="{StaticResource Hot30Brush}"/>
                <StackPanel Margin="12,10,12,10">
                    <TextBlock FontFamily="{StaticResource MonoFont}" FontSize="16"
                               Foreground="{StaticResource TextBrightBrush}" Text="{Binding Toast.SystemName}"/>
                    <TextBlock Margin="0,2,0,0" FontSize="13" Foreground="{StaticResource TextBodyBrush}"
                               Text="{Binding Toast.Detail}"/>
                    <DockPanel Margin="0,8,0,0">
                        <TextBlock DockPanel.Dock="Left" FontFamily="{StaticResource MonoFont}" FontSize="10"
                                   Foreground="{StaticResource TextMutedBrush}" Text="{Binding Toast.Who}"/>
                        <Button DockPanel.Dock="Right" HorizontalAlignment="Right"
                                Style="{StaticResource LinkButton}" FontSize="10"
                                Foreground="{StaticResource HotBrush}" Content="zkill ↗"
                                Command="{Binding OpenUrlCommand}" CommandParameter="{Binding Toast.Url}"/>
                    </DockPanel>
                </StackPanel>
            </StackPanel>
        </controls:CutCornerBorder>
    </Grid>
</Window>
