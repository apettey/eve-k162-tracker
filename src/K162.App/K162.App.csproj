<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>K162.App</RootNamespace>
    <AssemblyName>K162.App</AssemblyName>
    <ApplicationTitle>K162 Fleet Intel</ApplicationTitle>
    <!-- Source of truth for local builds; bumped by scripts/release.ps1. CI overrides with -p:Version from the tag. -->
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\K162.Core\K162.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\Fonts\*.ttf" />
    <Content Include="Assets\Data\wormholes.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
